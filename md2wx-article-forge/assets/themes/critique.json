{
  "name": "critique",
  "body_color": "#2e2e2e",
  "body_size": "15px",
  "line_height": "1.7em",
  "h1_size": "24px",
  "h2_size": "20px",
  "h3_size": "18px",
  "accent": "#1e3b5a",
  "code_bg": "#f2f3f5",
  "code_color": "#2e2e2e",
  "quote_color": "#666666",
  "link_color": "#576b95",
  "font_stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
  "components": {
    "lead": {
      "background": "linear-gradient(135deg, #f5f7fa 0%, #e9edf5 100%)",
      "padding": "12px 14px",
      "border-radius": "12px",
      "margin": "12px 0px"
    },
    "pain": {
      "background": "#fff8f0",
      "padding": "10px 12px",
      "border-radius": "8px",
      "border-left": "4px solid #e67e22",
      "margin": "6px 0px"
    },
    "module": {
      "background": "#ffffff",
      "box-shadow": "0 2px 12px rgba(0,0,0,0.06)",
      "border-radius": "12px",
      "padding": "12px 12px",
      "margin": "12px 0px"
    },
    "note": {
      "background": "#eef6ff",
      "padding": "8px 10px",
      "border-radius": "6px",
      "margin": "6px 0px"
    },
    "warn": {
      "background": "#fff0ed",
      "padding": "8px 10px",
      "border-radius": "6px",
      "margin": "6px 0px"
    },
    "cost": {
      "background": "#fef9e7",
      "padding": "8px 10px",
      "border-radius": "6px",
      "margin": "6px 0px"
    },
    "fact": {
      "background": "#f2f3f5",
      "padding": "8px 10px",
      "border-radius": "6px",
      "margin": "6px 0px"
    },
    "verdict": {
      "background": "#1e293b",
      "color": "#e2e8f0",
      "strong_color": "#facc15",
      "padding": "13px 14px",
      "border-radius": "14px",
      "margin": "14px 0px",
      "text-align": "center"
    },
    "footer": {
      "color": "#999999",
      "padding": "0px",
      "margin": "14px 0px 0px",
      "text-align": "center"
    }
  }
}
