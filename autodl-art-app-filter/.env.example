# 复制为 .env 后按需填写；.env 已被 .gitignore 排除，不会进 Git。
# 本包是纯筛选：无开发者 token、无网页 JWT，只有下面这些可选项。
#
# 大模型代理（OpenAI 兼容；默认指向本机 agnes-key-pool，本地代理不校验 key）
AUTODL_ART_LLM_BASE_URL=http://127.0.0.1:8765/v1
AUTODL_ART_LLM_MODEL=agnes-3.0-flash
AUTODL_ART_LLM_KEY=any
#
# 陈旧闸门（可选）：超过 STALE_DAYS 天未更新的应用在进大模型前被剔除；
# 超过 AGING_DAYS 天的要在筛选理由里提示"维护偏旧"
AUTODL_ART_STALE_DAYS=180
AUTODL_ART_AGING_DAYS=90
