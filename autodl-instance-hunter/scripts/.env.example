# AutoDL 浏览器机器人的环境变量模板（脱敏）
# 用法：复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交。
# 本模板中的账号、路径均为占位符，不含任何真实凭证。

# ---------- 登录凭证 ----------
AUTODL_USERNAME=your_phone_here
AUTODL_PASSWORD=your_password_here

# ---------- 目标机器 ----------
# GPU 型号支持逗号分隔的优先级列表：先找前者，全地区无货才找后者。
# 写法随意（VGPU-48g-350w / VGPU-32G 均可），config.normalize_model 会归一成
# 规范形式 vGPU-48GB-350W / vGPU-32GB。
# 注意：vGPU-48GB-350W 与 vGPU-48GB 是两个独立型号，脚本只做整体精确匹配，绝不混淆。
AUTODL_GPU_MODEL=vGPU-48GB-350W,vGPU-32GB
AUTODL_GPU_COUNT=1
AUTODL_BILLING_MODE=按量计费
AUTODL_FRAMEWORK=PyTorch

# ---------- 运行行为 ----------
# headless=false 表示显示浏览器窗口（测试阶段建议打开，便于观察每一步）
AUTODL_HEADLESS=false
# dry_run=true 表示只跑到"创建并开机"前一步，不会真的下单扣费
AUTODL_DRY_RUN=true
# 安全闸门：真正点击"创建并开机"（扣费）前必须人工在终端输入 yes 确认。强烈建议保持 true
AUTODL_REQUIRE_HUMAN_CONFIRM=true

# ---------- 轮询与重试 ----------
# 每次在算力市场没找到空闲机器后的等待秒数（建议 >=10，避免触发平台风控）
AUTODL_RETRY_INTERVAL_SECONDS=15
# 最大重试次数，0 表示无限循环
AUTODL_MAX_RETRIES=0

# ---------- 实例数量管控 ----------
# 出租/开机前先盘点 /console/instance/list：
# 同时处于运行中状态的实例上限。达到上限 -> 什么都不做；
# 未达上限且有已关机实例 -> 优先点"开机"复用（该主机资源不足会自动试下一台，
#   按"距释放时间最久"优先，最不容易中途被释放）；
# 未达上限且无已关机实例（或全部开机失败）-> 才去算力市场租新机。
# 0 = 不管控上限，保持"直接租新"的旧行为。
AUTODL_MAX_RUNNING_INSTANCES=2
# 发现已关机实例时是否自动开机复用（true=开机优先于租新）
AUTODL_AUTO_POWER_ON=true
# 是否启用上面的"实例盘点/开机复用"流程：
# true  = 正常流程（先实例区复用，不够才租新）
# false = 完全忽略已有实例，直接去算力市场租全新机器（不想动现有实例时用）
# 注意：无论 true/false，运行中实例上限 AUTODL_MAX_RUNNING_INSTANCES 都生效
AUTODL_REUSE_INSTANCES=true

# ---------- 登录态持久化 ----------
# 普通模式：登录成功后把 cookie+localStorage 存到该文件，下次免验证码
AUTODL_COOKIE_FILE=autodl_cookies.json

# ---------- 零登录方案（推荐，风控最低） ----------
# 本机已登录 AutoDL 的 Chrome 用户数据目录。
# Windows 示例：C:\Users\<你的用户名>\AppData\Local\Google\Chrome\User Data
# 启用后脚本会先把该 profile 复制到非默认路径（见下），再用真实 Chrome 以副本启动，
# 从而零登录直接进市场；副本与真实 Chrome 互不干扰、无需关闭 Chrome。
# 前提：先在真实 Chrome 里登录一次 AutoDL（JWT 约 60 天有效，过期需重登并删除副本目录）。
# 注意：profile_util.ensure_profile_copy 依赖 Windows 的 robocopy，非 Windows 需自行改造。
AUTODL_USER_DATA_DIR=

# profile 副本目录（可选，默认项目下 chrome_profile/）。删除它可强制下次重新复制最新登录态。
# AUTODL_PROFILE_COPY_DIR=./chrome_profile
