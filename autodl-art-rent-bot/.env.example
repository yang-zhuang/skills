# 复制为 .env 后填写；.env 已被 .gitignore 排除，不会进 Git
# 开发者 Token 获取：https://www.autodl.com/console/center/settings/token
AUTODL_DEV_TOKEN=

# 网页登录 JWT（extract_jwt.py 自动写入并刷新，无需手填）
AUTODL_ART_WEB_JWT=

# 大模型代理（OpenAI 兼容；默认指向本机 agnes-key-pool，本地代理不校验 key）
AUTODL_ART_LLM_BASE_URL=http://127.0.0.1:8765/v1
AUTODL_ART_LLM_MODEL=agnes-3.0-flash
AUTODL_ART_LLM_KEY=any
