# translate-zh 路径配置模板。复制为 .env 并按本机情况修改；全部可省略。
# 优先级：系统环境变量 > .env > 默认值（读取逻辑见 skills/translate-zh/scripts/_config.py）
# 默认值：语料落仓库内 corpus/；爬虫与 downloader 找仓库的兄弟目录；找不到时 fetch.py 自动降级。

# ACL Anthology 论文落盘根目录（fetch.py 下载 + 查重）
#ACL_ROOT=<磁盘>/acl-anthology/papers

# arXiv 论文落盘根目录
#ARXIV_ROOT=<磁盘>/arxiv

# 博客爬虫仓库根（含 lilianweng-posts / langchain-blog / anthropic-research 三个子目录）。
# 缺失时 fetch.py 降级为通用抓取，落盘到 outputs/articles/<site>/
#CRAWLERS_ROOT=<工作目录>/blog-research-crawlers

# acl-anthology-downloader 仓库根（含 downloader.py）。缺失时 ACL 直接下 PDF（落盘结构不变）
#ACL_DOWNLOADER=<工作目录>/acl-anthology-downloader

# pdf-ocr-toolkit 仓库根（含 ocr_pdfs.py，扫描件 OCR 用，可选增强）
#OCR_TOOLKIT=<工作目录>/pdf-ocr-toolkit

# ---- OCR（skills/translate-zh/scripts/ocr_pdfs.py，扫描件才需要）----

# official 模式必填：PaddleOCR aistudio 的 token（aistudio.baidu.com 免费注册可得）
#OCR_TOKEN=

# 服务地址与模型（一般不用改）
#OCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
#OCR_MODEL=PaddleOCR-VL-1.6

# official（aistudio API）| local（私有化部署）
#OCR_MODE=official
#OCR_LOCAL_API_URL=http://127.0.0.1:8080/layout-parsing
#OCR_LOCAL_API_TOKEN=

# OCR 落盘目录名 / json 文件名 / 解析顺序（path|pages，pages=页数少的先跑）
#OCR_OUT_DIR_NAME=paddle_ocr_vl_1_6
#OCR_JSON_NAME=paddle_ocr_vl.json
#OCR_ORDER=path
